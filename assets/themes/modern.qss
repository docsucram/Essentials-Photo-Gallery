/* Modern Fluent Theme - Windows 11 Fluent Design */
QMainWindow {
    background-color: #F9FAFB;
    color: #111827;
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
}

QWidget {
    font-family: "Segoe UI", sans-serif;
}

QDialog {
    background-color: #FFFFFF;
    color: #111827;
}

/* Push Buttons */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 4px 12px;
    color: #111827;
    font-family: "Segoe UI", sans-serif;
    font-size: 9pt;
}

QPushButton:hover {
    background-color: #F3F4F6;
    border-color: #9CA3AF;
}

QPushButton:pressed {
    background-color: #E5E7EB;
    border-color: #6B7280;
}

QPushButton:checked {
    background-color: #EFF6FF;
    border-color: #0F6CBD;
    color: #0F6CBD;
    font-weight: 600;
}

QPushButton:disabled {
    background-color: #F9FAFB;
    border-color: #E5E7EB;
    color: #9CA3AF;
}

/* Tool Buttons */
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 2px 4px;
    color: #111827;
    font-family: "Segoe UI", sans-serif;
    font-size: 9pt;
}

QToolButton:hover {
    background-color: #E5E7EB;
    border-color: #D1D5DB;
}

QToolButton:pressed {
    background-color: #D1D5DB;
    border-color: #9CA3AF;
}

QToolButton:checked {
    background-color: #EFF6FF;
    border-color: #BFDBFE;
    color: #0F6CBD;
}

/* Dock Widgets */
QDockWidget {
    color: #111827;
    font-family: "Segoe UI", sans-serif;
    font-size: 9pt;
    font-weight: 600;
}

QDockWidget::title {
    background: #F3F4F6;
    text-align: left;
    padding: 5px 8px;
    border-bottom: 1px solid #E5E7EB;
    font-weight: 600;
    color: #374151;
}

/* Lists and Trees */
QListView {
    background-color: #FFFFFF;
    border: none;
    color: #111827;
}

QTreeWidget {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    color: #111827;
    font-size: 9pt;
}

QTreeWidget::item {
    padding: 3px 6px;
    border-radius: 4px;
    margin: 1px 2px;
}

QTreeWidget::item:hover {
    background-color: #F3F4F6;
}

QTreeWidget::item:selected {
    background-color: #EFF6FF;
    color: #0F6CBD;
    font-weight: 600;
}

/* Status Bar */
QStatusBar {
    background-color: #F3F4F6;
    border-top: 1px solid #E5E7EB;
    color: #374151;
    font-family: "Segoe UI", sans-serif;
    font-size: 8.5pt;
}

/* Tooltips */
QToolTip {
    background-color: #FFFFFF;
    color: #1F2937;
    border: 1px solid #E5E7EB;
    border-radius: 4px;
    padding: 4px 8px;
    font-family: "Segoe UI", sans-serif;
    font-size: 8.5pt;
}

/* Checkboxes */
QCheckBox {
    spacing: 6px;
    color: #1F2937;
    font-family: "Segoe UI", sans-serif;
    font-size: 9pt;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #D1D5DB;
    border-radius: 3px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #0F6CBD;
    background-color: #F9FAFB;
}

QCheckBox::indicator:checked {
    border: 1px solid #0F6CBD;
    background-color: #0F6CBD;
    image: url({ICONS_PATH}/check_white.svg);
}

QCheckBox::indicator:checked:hover {
    border-color: #115EA3;
    background-color: #115EA3;
}

QCheckBox::indicator:disabled {
    border-color: #E5E7EB;
    background-color: #F3F4F6;
}

/* Line Edits & Combos */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 3px 6px;
    color: #111827;
    font-family: "Segoe UI", sans-serif;
    font-size: 9pt;
}

QLineEdit:focus {
    border: 1px solid #0F6CBD;
    background-color: #FFFFFF;
}

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 3px 8px;
    color: #111827;
    font-family: "Segoe UI", sans-serif;
    font-size: 9pt;
}

QComboBox:hover {
    background-color: #F9FAFB;
    border-color: #9CA3AF;
}

QComboBox:focus {
    border: 1px solid #0F6CBD;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #D1D5DB;
    selection-background-color: #E8F2FC;
    selection-color: #0F172A;
    outline: none;
}

QComboBox QAbstractItemView::item {
    background-color: #FFFFFF;
    color: #111827;
    padding: 4px 8px;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: #E8F2FC;
    color: #0F172A;
}

/* Menus */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 4px;
    font-family: "Segoe UI", sans-serif;
    font-size: 9pt;
    color: #1F2937;
}

QMenu::item {
    padding: 5px 24px 5px 10px;
    border-radius: 4px;
    margin: 1px 2px;
}

QMenu::item:selected {
    background-color: #F3F4F6;
    color: #111827;
}

QMenu::separator {
    height: 1px;
    background-color: #E5E7EB;
    margin: 4px 6px;
}

/* Minimalist Modern Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #F1F5F9;
    width: 5px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background: #94A3B8;
    min-height: 28px;
    border-radius: 2px;
    margin: 0px;
}

QScrollBar::handle:vertical:hover {
    background: #64748B;
}

QScrollBar::handle:vertical:pressed {
    background: #475569;
}

QScrollBar::sub-line:vertical, QScrollBar::add-line:vertical {
    border: none;
    background: transparent;
    height: 0px;
    width: 0px;
}

QScrollBar::sub-page:vertical, QScrollBar::add-page:vertical {
    border: none;
    background: transparent;
}

QScrollBar:horizontal {
    border: none;
    background: #F1F5F9;
    height: 10px;
    width: 0px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:horizontal {
    background: #94A3B8;
    min-width: 28px;
    border-radius: 5px;
    margin: 1px;
}

QScrollBar::handle:horizontal:hover {
    background: #64748B;
}

QScrollBar::handle:horizontal:pressed {
    background: #475569;
}

QScrollBar::sub-line:horizontal, QScrollBar::add-line:horizontal {
    border: none;
    background: transparent;
    width: 0px;
    height: 0px;
}

QScrollBar::sub-page:horizontal, QScrollBar::add-page:horizontal {
    border: none;
    background: transparent;
}

QAbstractScrollArea::corner {
    background: transparent;
    border: none;
}

/* ============================================================================
   Semantic uiRole Rules (ThemeTokens: modern)
   ============================================================================ */
QWidget[uiRole="surface"] {
    background-color: #F8FAFC;
    color: #0F172A;
}

QFrame[uiRole="elevated"], QWidget[uiRole="elevated"] {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
}

QFrame[uiRole="card"], QWidget[uiRole="card"] {
    background-color: #F1F5F9;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
}

QLabel[uiRole="title"] {
    color: #0F172A;
    font-weight: 600;
    background: transparent;
}

QLabel[uiRole="muted"] {
    color: #475569;
    background: transparent;
}

QLabel[uiRole="empty_hint"] {
    padding: 16px;
    color: #475569;
    background-color: #F1F5F9;
    border: 1px dashed #CBD5E1;
    border-radius: 6px;
}

QPushButton[uiRole="primary_btn"] {
    background-color: #2563EB;
    color: #FFFFFF;
    border: 1px solid #1D4ED8;
    font-weight: 600;
    padding: 6px 16px;
    border-radius: 4px;
}
QPushButton[uiRole="primary_btn"]:hover {
    background-color: #1D4ED8;
}
QPushButton[uiRole="primary_btn"]:disabled {
    background-color: #94A3B8;
    border-color: #94A3B8;
    color: #F1F5F9;
}

QPushButton[uiRole="danger_btn"] {
    background-color: #DC2626;
    color: #FFFFFF;
    border: 1px solid #B91C1C;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 4px;
}
QPushButton[uiRole="danger_btn"]:hover {
    background-color: #B91C1C;
}
QPushButton[uiRole="danger_btn"]:disabled {
    background-color: #94A3B8;
    border-color: #94A3B8;
    color: #F1F5F9;
}

QProgressDialog {
    background-color: #F8FAFC;
    color: #0F172A;
}

QProgressBar {
    border: 1px solid #CBD5E1;
    border-radius: 5px;
    background-color: #E2E8F0;
    color: #0F172A;
    text-align: center;
    min-height: 20px;
    font-weight: 600;
}

QProgressBar::chunk {
    background-color: #0F6CBD;
    border-radius: 4px;
}

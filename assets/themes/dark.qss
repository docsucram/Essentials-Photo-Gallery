/* Dark Studio Theme */
QMainWindow {
    background-color: #16181D;
    color: #E2E8F0;
    font-family: "Segoe UI", sans-serif;
}

QDialog {
    background-color: #1B1E24;
    color: #E2E8F0;
}

QDialog QLabel {
    background-color: transparent;
    color: #E2E8F0;
}

QListView {
    background-color: #121417;
    color: #E2E8F0;
    border: none;
}

QListWidget {
    background-color: #14171B;
    color: #E2E8F0;
    border: 1px solid #333A45;
    border-radius: 4px;
}

QListWidget::item:hover {
    background-color: #242A36;
}

QListWidget::item:selected {
    background-color: #1E3A5F;
    color: #FFFFFF;
}

QTreeWidget {
    background-color: #17191E;
    color: #E2E8F0;
    border: 1px solid #2D323B;
}

QGroupBox {
    background-color: #20242C;
    border: 1px solid #2E3440;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 10px;
    color: #E2E8F0;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
    color: #60A5FA;
    background-color: transparent;
}

QTabWidget::pane {
    background-color: #1B1E24;
    border: 1px solid #2E3440;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #14171B;
    color: #94A3B8;
    border: 1px solid #2E3440;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 12px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #22262E;
    color: #E2E8F0;
}

QTabBar::tab:selected {
    background-color: #1B1E24;
    color: #60A5FA;
    font-weight: 600;
    border-color: #3B82F6;
    border-bottom: 1px solid #1B1E24;
}

QPushButton {
    background-color: #262B35;
    color: #E2E8F0;
    border: 1px solid #3E4756;
    border-radius: 4px;
    padding: 4px 10px;
}

QPushButton:hover {
    background-color: #303744;
    border-color: #3B82F6;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #1E3A5F;
    border-color: #60A5FA;
}

QPushButton:disabled {
    background-color: #1A1D23;
    color: #64748B;
    border-color: #2A2E37;
}

QLineEdit, QSpinBox, QDateEdit, QTimeEdit, QPlainTextEdit, QTextEdit {
    background-color: #14171B;
    color: #F1F5F9;
    border: 1px solid #333A45;
    border-radius: 3px;
    padding: 3px 6px;
}

QLineEdit:focus, QSpinBox:focus, QDateEdit:focus, QTimeEdit:focus {
    border: 1px solid #3B82F6;
    background-color: #181C22;
}

QComboBox {
    background-color: #22262E;
    color: #E2E8F0;
    border: 1px solid #3E4756;
    border-radius: 4px;
    padding: 3px 8px;
}

QComboBox:hover {
    border-color: #3B82F6;
    background-color: #282D37;
}

QComboBox QAbstractItemView {
    background-color: #1B1E24;
    color: #E2E8F0;
    border: 1px solid #3E4756;
    selection-background-color: #1E3A5F;
    selection-color: #FFFFFF;
}

QMenu {
    background-color: #1B1E24;
    color: #E2E8F0;
    border: 1px solid #333A45;
    padding: 4px;
}

QMenu::item {
    padding: 5px 24px 5px 12px;
    border-radius: 3px;
    color: #E2E8F0;
}

QMenu::item:selected {
    background-color: #2563EB;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #64748B;
}

QMenu::separator {
    height: 1px;
    background: #2D323B;
    margin: 4px 6px;
}

QStatusBar {
    background-color: #171A20;
    color: #CBD5E1;
    border-top: 1px solid #2A2E37;
}

QStatusBar QLabel {
    color: #CBD5E1;
    background-color: transparent;
}

QToolTip {
    background-color: #FFFFFF;
    color: #1E395B;
    border: 1px solid #767676;
    border-radius: 2px;
    padding: 3px 6px;
    font-family: "Segoe UI", sans-serif;
    font-size: 12px;
}

QCheckBox {
    spacing: 6px;
    color: #E2E8F0;
    background-color: transparent;
    font-family: "Segoe UI", sans-serif;
    font-size: 9pt;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #475569;
    border-radius: 3px;
    background-color: #14171B;
}

QCheckBox::indicator:hover {
    border-color: #3B82F6;
    background-color: #1E242D;
}

QCheckBox::indicator:checked {
    border: 1px solid #3B82F6;
    background-color: #2563EB;
    image: url({ICONS_PATH}/check_white.svg);
}

QCheckBox::indicator:checked:hover {
    border-color: #60A5FA;
    background-color: #1D4ED8;
}

QCheckBox::indicator:disabled {
    border-color: #2D323B;
    background-color: #1A1D23;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #2E3440;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #3B82F6;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #E2E8F0;
    border: 1px solid #3B82F6;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: #FFFFFF;
    border-color: #60A5FA;
}

/* Minimalist modern scrollbars (dark mode) */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #4B5563;
    min-height: 28px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #6B7280;
}
QScrollBar::handle:vertical:pressed {
    background: #9CA3AF;
}
QScrollBar::sub-line:vertical, QScrollBar::add-line:vertical {
    border: none;
    background: transparent;
    height: 0px;
    width: 0px;
}
QScrollBar::sub-page:vertical, QScrollBar::add-page:vertical {
    border: none;
    background: transparent;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 0px;
    width: 0px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:horizontal, QScrollBar::sub-line:horizontal, QScrollBar::add-line:horizontal {
    border: none;
    background: transparent;
    width: 0px;
    height: 0px;
}
QScrollBar::sub-page:horizontal, QScrollBar::add-page:horizontal {
    border: none;
    background: transparent;
}
QAbstractScrollArea::corner {
    background: transparent;
    border: none;
}
